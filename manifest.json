{
  "manifest_version": 3,
  "name": "PlayFetch",
  "version": "1.3",
  "description": "Fetches the direct MP4 link of HypnoTube and RedGifs videos: copies it and opens it with one click",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_title": "PlayFetch: copy and open the direct MP4 link"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://hypnotube.com/video*",
        "https://*.redgifs.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "clipboardWrite",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://hypnotube.com/video*",
    "https://*.redgifs.com/*"
  ]
}
